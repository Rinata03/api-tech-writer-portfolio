{
	"info": {
		"_postman_id": "7b89c321-4d1a-42a9-b123-abcdef123456",
		"name": "Document Processing Service API",
		"description": "Коллекция для интеграционного тестирования сервиса обработки документов",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Документы",
			"item": [
				{
					"name": "Создать и отправить документ на процессинг",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Автоматическая генерация уникального ключа идемпотентности",
									"pm.request.headers.add({",
									"    key: 'X-Idempotency-Key',",
									"    value: pm.variables.replaceIn('{{$guid}}')",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"// 1. Проверка успешного статуса 201 Created",
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"// 2. Проверка времени ответа (SLA до 800ms)",
									"pm.test(\"Response time is less than 800ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(800);",
									"});",
									"",
									"// 3. Проверка наличия обязательных полей и сохранение ID",
									"pm.test(\"Response has documentId and status is PROCESSING\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('documentId');",
									"    pm.expect(jsonData.status).to.eql(\"PROCESSING\");",
									"    ",
									"    // Сохраняем ID документа в переменные окружения",
									"    pm.environment.set(\"lastCreatedDocId\", jsonData.documentId);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"externalId\": \"CRM-DOC-10928\",\n    \"docType\": \"LOAN_AGREEMENT\",\n    \"payloadBase64\": \"JVBERi0xLjQKJcOkw7zDtsOf...\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/documents/process",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"documents",
								"process"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://api-stage.bank.internal/v1"
		},
		{
			"key": "jwtToken",
			"value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
		},
		{
			"key": "lastCreatedDocId",
			"value": ""
		}
	]
}
